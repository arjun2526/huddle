{
  "expo": {
    "name": "HUDDLE",
    "slug": "huddle",
    "version": "1.0.0",
    "scheme": "huddle",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.huddle.app"
    },
    "ios": {
      "bundleIdentifier": "com.huddle.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/huddle"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "HUDDLE needs your photos to share posts and reels."
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
